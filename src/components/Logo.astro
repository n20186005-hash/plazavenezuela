---
const { compact = false, light = false } = Astro.props;
---
<a class:list={["inline-flex items-center gap-3 no-underline", light && "text-white"]} href="/" aria-label="Guía Plaza Venezuela — inicio">
  <svg viewBox="0 0 64 64" class="h-11 w-11 shrink-0" role="img" aria-hidden="true">
    <circle cx="32" cy="32" r="30" fill={light ? '#f4f0e7' : '#17211f'} />
    <path d="M13 39c8-13 30-13 38 0" fill="none" stroke="#146fa6" stroke-width="5" stroke-linecap="round" />
    <path d="M19 39c6-8 20-8 26 0" fill="none" stroke="#f2b544" stroke-width="4" stroke-linecap="round" />
    <path d="M32 15v19" stroke="#d95d48" stroke-width="5" stroke-linecap="round" />
    <path d="M24 19l4 13M40 19l-4 13" stroke={light ? '#17211f' : '#f4f0e7'} stroke-width="3" stroke-linecap="round" />
  </svg>
  {!compact && (
    <span class="leading-none">
      <strong class="block text-[.95rem] tracking-[.05em]">PLAZA VENEZUELA</strong>
      <span class="mt-1 block text-[.7rem] uppercase tracking-[.19em] opacity-70">Guía independiente</span>
    </span>
  )}
</a>
