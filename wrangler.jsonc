{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plazavenezuela",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "main": "worker.mjs"
}
