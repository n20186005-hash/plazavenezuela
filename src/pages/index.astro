---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteInfo } from '../data/site';
import { faqs, seasonalTableRows } from '../data/visitor';
import Weather from '../components/Weather.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
const siteUrl = Astro.site!.origin;
const attractionId = `${siteUrl}/#attraction`;
const attractionSchema = {
  '@type': ['TouristAttraction', 'LandmarkOrHistoricalBuilding'],
  '@id': attractionId, name: siteInfo.placeName,
  alternateName: ['Plaza Venezuela, Caracas', 'Fuente de Plaza Venezuela'],
  description: siteInfo.description, url: `${siteUrl}/`,
  image: Object.values(siteInfo.photos).map(photo => new URL(photo.src, siteUrl).href),
  address: { '@type': 'PostalAddress', streetAddress: siteInfo.streetAddress, addressLocality: siteInfo.locality, addressRegion: siteInfo.region, postalCode: siteInfo.postalCode, addressCountry: siteInfo.countryCode },
  geo: { '@type': 'GeoCoordinates', latitude: siteInfo.latitude, longitude: siteInfo.longitude },
  hasMap: siteInfo.mapsUrl, sameAs: [siteInfo.mapsUrl]
};
const structuredData = [
  attractionSchema,
  { '@type': 'WebSite', '@id': `${siteUrl}/#website`, name: siteInfo.name, url: `${siteUrl}/`, inLanguage: 'es-VE' },
  { '@type': 'WebPage', '@id': `${siteUrl}/#webpage`, name: siteInfo.seo.title, description: siteInfo.seo.description, url: `${siteUrl}/`, inLanguage: 'es-VE', isPartOf: { '@id': `${siteUrl}/#website` }, mainEntity: { '@id': attractionId } },
  { '@type': 'FAQPage', mainEntity: faqs.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }
];
const pageTitle = siteInfo.seo.title, pageDescription = siteInfo.seo.description, pageKeywords = siteInfo.seo.keywords, canonicalUrl = `${siteUrl}/`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonical={canonicalUrl}
  image={siteInfo.photos.panorama.src}
  imageAlt={`Plaza Venezuela en Caracas, Distrito Capital, Venezuela · Fuente luminosa y arte cinético`}
  structuredData={structuredData}
>

  <section class="pv-hero relative isolate min-h-[76vh] overflow-hidden bg-ink text-white">
    <img
      src={siteInfo.photos.panorama.src}
      alt={siteInfo.photos.panorama.alt} width={siteInfo.photos.panorama.width} height={siteInfo.photos.panorama.height}
      class="absolute inset-0 h-full w-full object-cover opacity-65"
      fetchpriority="high"
      referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(16,28,26,.88)_0%,rgba(16,28,26,.5)_52%,rgba(16,28,26,.22)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-ink/85 to-transparent"></div>
    <div class="site-shell relative flex min-h-[76vh] items-end pb-14 pt-36">
      <div class="max-w-4xl">
        <nav aria-label="Breadcrumb" class="mb-5 text-xs text-white/60">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="https://plazavenezuela.org" class="hover:underline">Plaza Venezuela</a></li>
            <li aria-hidden="true">›</li>
            <li><span>Caracas</span></li>
            <li aria-hidden="true">›</li>
            <li><span>Distrito Capital</span></li>
            <li aria-hidden="true">›</li>
            <li><span>Venezuela</span></li>
          </ol>
        </nav>
        <span class="eyebrow text-sun">Guía sin fines de lucro · Ubicación · Cómo llegar en Metro · Horario y consejos</span>
        <h1 class="display mt-5 max-w-4xl text-[clamp(3rem,8vw,7.4rem)]">Plaza Venezuela <span class="text-white/70">Caracas</span></h1>
        <p class="mt-7 max-w-3xl text-lg leading-8 text-white/82 md:text-xl">
          <strong>Plaza Venezuela</strong> es un espacio público y nodo urbano de <strong>Caracas</strong>, <strong>Distrito Capital</strong>. Punto de referencia para la fuente iluminada, el <strong>arte cinético venezolano</strong>, el <strong>Metro de Caracas</strong> y los paseos peatonales hacia <em>Sabana Grande</em>, el <em>Parque Los Caobos</em>, el <em>Jardín Botánico</em> y la <em>Ciudad Universitaria</em>.
        </p>
        <p class="mt-6 max-w-3xl text-base leading-7 text-white/75 md:text-lg">
          <strong>Ubicación:</strong> Av. Casanova, Caracas 1052 · Plus Code <strong>F4W7+MMM</strong> ·
          <strong>Cómo llegar:</strong> <strong>{siteInfo.seo.nearStation}</strong> ·
          <strong>Acceso y fuente:</strong> confirma las condiciones del día.
        </p>
        <div class="mt-8 flex flex-wrap gap-3 text-sm">
          <span class="rounded-full border border-white/30 bg-black/20 px-4 py-2 backdrop-blur">Google Maps: {siteInfo.rating} / 5 · {siteInfo.ratingCount.toLocaleString('es-VE')} valoraciones</span>
          <span class="rounded-full border border-white/30 bg-black/20 px-4 py-2 backdrop-blur">Confirma condiciones de acceso</span>
          <span class="rounded-full border border-white/30 bg-black/20 px-4 py-2 backdrop-blur">Google Maps: {siteInfo.hours}; sujeto a cambios</span>
          <span class="rounded-full border border-white/30 bg-black/20 px-4 py-2 backdrop-blur">Plaza al aire libre · Open-air plaza</span>
        </div>
      </div>
    </div>
    <div class="site-shell relative z-10 pb-8"><PhotoCredit photo={siteInfo.photos.panorama} /></div>
    <div class="absolute right-0 top-24 hidden h-[64%] w-28 overflow-hidden lg:block" aria-hidden="true">
      <div class="h-full w-full bg-[repeating-linear-gradient(90deg,transparent_0_10px,#f2b544_10px_15px,transparent_15px_24px,#d95d48_24px_29px,transparent_29px_38px,#1a85be_38px_43px)] opacity-75 [transform:skewX(-12deg)]"></div>
    </div>
  </section>

  <section class="site-shell -mt-1 grid border-x border-b border-black/10 bg-paper md:grid-cols-4">
    {[
      ['Caracas', 'Espacio urbano'],
      ['1982', 'Arte cinético emblemático'],
      ['2009', 'Nueva etapa de la fuente'],
      ['Hoy', 'Nodo cultural y de transporte']
    ].map(([big, small]) => (
      <div class="border-b border-black/10 p-6 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0">
        <strong class="display block text-4xl">{big}</strong>
        <span class="mt-2 block text-xs font-bold uppercase tracking-[.1em] text-black/55">{small}</span>
      </div>
    ))}
  </section>

  <p class="site-shell mt-6 text-sm leading-7">Ficha de Google Maps consultada el 22 de octubre de 2026: {siteInfo.rating}/5, {siteInfo.ratingCount.toLocaleString('es-VE')} valoraciones. Es una ficha de terceros, no una puntuación de esta guía. Muestra {siteInfo.hours} todos los días, con advertencia de cambios en festivos; no es un horario de espectáculos ni una garantía de acceso. <a class="underline" href={siteInfo.mapsUrl}>Consulta la ficha y confirma antes de ir</a>.</p>

  <Weather />

  <section id="estacional" class="site-shell py-24">
    <div class="grid gap-12 lg:grid-cols-[.6fr_1.4fr]">
      <div>
        <span class="eyebrow text-cobalt">Planificación</span>
        <h2 class="display mt-5 text-[clamp(2.8rem,5.5vw,6rem)]">Preparación mes a mes.</h2>
        <p class="mt-6 leading-8 text-black/62">
Estas propuestas son recordatorios para preparar la visita; no son promedios climáticos ni un calendario de funcionamiento. Consulta el pronóstico del día, los accesos y el transporte.
        </p>
      </div>
      <div class="overflow-x-auto rounded-[1.5rem] border border-black/10 bg-white shadow-[0_25px_80px_rgba(23,33,31,.08)]">
        <table class="w-full min-w-[640px] border-collapse text-sm">
          <caption class="px-6 pt-6 pb-3 text-left text-xs font-bold uppercase tracking-[.14em] text-black/45">
Planificación flexible durante el año
          </caption>
          <thead class="bg-paper text-black/80">
            <tr>
              <th scope="col" class="px-3 py-3 text-left">Mes</th>
              <th scope="col" class="px-3 py-3 text-left">Preparación</th>
              <th scope="col" class="px-3 py-3 text-left">Arte y fotografía</th>
              <th scope="col" class="px-3 py-3 text-left">Verificar antes de ir</th>
            </tr>
          </thead>
          <tbody>
            {seasonalTableRows.map((row, i) => (
              <tr class={'border-t border-black/8 ' + (i % 2 ? 'bg-white' : 'bg-white/70')}>
                <th scope="row" class="px-3 py-3 text-left font-bold">{row[0]}</th>
                <td class="px-3 py-3">{row[1]}</td>
                <td class="px-3 py-3">{row[2]}</td>
                <td class="px-3 py-3">{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="about" class="site-shell grid gap-12 py-24 lg:grid-cols-[.82fr_1.18fr] lg:gap-20">
    <div>
      <span class="eyebrow text-cobalt">Sobre Plaza Venezuela</span>
      <h2 class="display mt-5 text-[clamp(2.8rem,5.5vw,6rem)]">Sobre Plaza Venezuela</h2>
    </div>
    <div class="space-y-6 text-[1.05rem] leading-8 text-black/70">
      <p>
        <strong>Plaza Venezuela</strong> (Caracas) reúne una fuente, obras de arte público y conexiones urbanas en el entorno de Avenida Casanova. Esta guía trata ese espacio; Plaza El Venezolano, en el centro histórico, es otro destino.
      </p>
      <p>
        Plaza Venezuela forma parte del desarrollo urbano de Caracas hacia el este. No funciona únicamente como una plaza tradicional: es a la vez paseo peatonal, distribuidor vial, punto de referencia y antesala de varios conjuntos culturales y universitarios de la ciudad.
      </p>
      <p>
        Su identidad actual se construyó por capas. A la fuente monumental se sumaron obras que convirtieron el entorno en una pequeña lección de arte venezolano al aire libre. <strong class="text-ink">Abra Solar</strong>, de Alejandro Otero, y la <strong class="text-ink">Fisicromía — Homenaje a Don Andrés Bello</strong>, de Carlos Cruz-Díez, enlazan la plaza con la tradición cinética venezolana del siglo XX.
      </p>
      <p>
        Entre 2007 y 2009 se ejecutó una rehabilitación integral del conjunto y de sus obras. La versión de la fuente puesta en servicio en 2009 incorporó control de iluminación y recursos sonoros, reforzando el carácter nocturno del lugar. El proyecto histórico no acredita la apertura actual de servicios o instalaciones.
      </p>
      <aside class="mt-8 border-l-4 border-sun bg-white p-6 text-sm leading-7 shadow-[0_18px_60px_rgba(23,33,31,.08)]">
        <strong class="block text-base text-ink">Cómo leer la plaza</strong>
        No busques un único "monumento principal". El interés está en la relación entre circulación, paisaje, fuente, arquitectura y arte cinético: una composición urbana que cambia según la luz, el movimiento del visitante y la actividad de la ciudad.
      </aside>
    </div>
  </section>

  <section id="historia" class="bg-paper/60 py-24">
    <div class="site-shell grid gap-12 lg:grid-cols-[.82fr_1.18fr] lg:gap-20">
      <div>
        <span class="eyebrow text-coral">Historia urbana</span>
        <h2 class="display mt-5 text-[clamp(2.8rem,5.5vw,6rem)]">Historia y significado</h2>
      </div>
      <div class="space-y-6 text-[1.05rem] leading-8 text-black/70">
        <p>
          La historia del conjunto puede leerse en sus obras y en los proyectos de rehabilitación documentados. Conviene distinguir esa historia de las condiciones que encontrarás durante la visita.
        </p>
        <p>
          <strong>Un conjunto urbano en transformación.</strong>La relación entre calles, recorridos peatonales y arte permite leer distintas etapas de Caracas. No se ha verificado aquí un documento sobre los motivos formales del nombre de la plaza.
        </p>
        <p>
          <strong>El transporte como referencia.</strong>La Fundación Fondo Andrés Bello de la UCV documenta el entorno de Zona Rental y las estaciones Plaza Venezuela y Zona Rental. Esa documentación ayuda a ubicar el conjunto, pero no sustituye la información del servicio actual.
        </p>
        <p>
          El archivo BAQ describe la recuperación conjunta de la fuente, Abra Solar y la Fisicromía. Sus fichas explican la relación entre patrimonio, arte y uso del espacio público.
        </p>
        <p>
          <strong>La rehabilitación documentada.</strong>El proyecto presentado en BAQ 2010 describe trabajos desde 2007 y obras civiles de la fuente hasta mayo de 2009, con intervención en iluminación, sonido y formas de agua. Es documentación histórica, no una garantía de funcionamiento actual.
        </p>
        <p>
          <strong>Sin un horario de espectáculo confirmado.</strong>
No se han encontrado aquí un programa vigente de la fuente ni documentación para las historias populares que circulan sobre ella. Consulta las indicaciones del lugar; no planifiques la visita alrededor de una supuesta función fija.
        </p>
        <p>
          Hoy en día, Plaza Venezuela sigue siendo un símbolo de identidad nacional y un punto de encuentro para caraqueños y visitantes. Su significado trasciende lo arquitectónico: es un espacio donde convergen la memoria histórica, la expresión artística y la vida cotidiana de una ciudad en movimiento.
        </p>
      </div>
    </div>
  </section>

  <section id="arte" class="bg-ink py-24 text-white">
    <div class="site-shell">
      <div class="max-w-3xl">
        <span class="eyebrow text-sun">Arte en movimiento</span>
        <h2 class="display mt-5 text-[clamp(3.2rem,6.5vw,7rem)]">Dos maneras de hacer visible el tiempo.</h2>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-white/68">Otero trabaja con estructura, viento y reflejo. Cruz-Díez hace que el color se transforme a medida que cambia tu posición.</p>
      </div>

      <div class="mt-14 grid gap-8 lg:grid-cols-2">
        <article class="group overflow-hidden border border-white/15 bg-white/5">
          <div class="aspect-[4/3] overflow-hidden">
            <img src={siteInfo.photos.abraSolar.src} alt={siteInfo.photos.abraSolar.alt} width={siteInfo.photos.abraSolar.width} height={siteInfo.photos.abraSolar.height} loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" referrerpolicy="no-referrer" />
          </div>
          <div class="p-7 md:p-9">
            <span class="text-xs font-bold uppercase tracking-[.16em] text-sun">Alejandro Otero · 1982</span>
            <h3 class="display mt-3 text-4xl">Abra Solar</h3>
            <p class="mt-4 leading-7 text-white/68">Una gran estructura de aluminio concebida como obra cinética: sus elementos responden al viento y la luz. Más que una escultura estática, propone observar cómo el ambiente modifica lo que vemos.</p>
            <PhotoCredit photo={siteInfo.photos.abraSolar} />
          </div>
        </article>

        <article class="group overflow-hidden border border-white/15 bg-white/5 lg:mt-20">
          <div class="aspect-[4/3] overflow-hidden">
            <img src={siteInfo.photos.fisicromia.src} alt={siteInfo.photos.fisicromia.alt} width={siteInfo.photos.fisicromia.width} height={siteInfo.photos.fisicromia.height} loading="lazy" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" referrerpolicy="no-referrer" />
          </div>
          <div class="p-7 md:p-9">
            <span class="text-xs font-bold uppercase tracking-[.16em] text-coral">Carlos Cruz-Díez · 1982</span>
            <h3 class="display mt-3 text-4xl">Fisicromía — Homenaje a Don Andrés Bello</h3>
            <p class="mt-4 leading-7 text-white/68">El color deja de ser una superficie fija. Las franjas cromáticas producen lecturas distintas desde cada ángulo; caminar frente a la obra forma parte de la experiencia.</p>
            <PhotoCredit photo={siteInfo.photos.fisicromia} />
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="visita" class="site-shell py-24">
    <div class="grid gap-12 lg:grid-cols-[.78fr_1.22fr]">
      <div>
        <span class="eyebrow text-leaf">Planifica la visita</span>
        <h2 class="display mt-5 text-[clamp(3rem,6vw,6rem)]">Lo práctico, sin venderte nada.</h2>
        <p class="mt-6 max-w-md leading-7 text-black/62">La plaza está en un entorno central, denso y muy conectado. Los servicios cambian con la operación urbana; por eso distinguimos lo estable de lo que conviene confirmar el mismo día.</p>
      </div>

      <div class="grid gap-px overflow-hidden border border-black/10 bg-black/10 sm:grid-cols-2">
        {[
          ['Entrada / costo', 'Confirma condiciones', 'No se ha verificado una tarifa actual ni el acceso gratuito en toda circunstancia. Transporte y servicios tienen condiciones aparte.'],
          ['Horario de referencia', '06:00–21:00', 'Ficha de Google Maps del 22 de octubre de 2026: sujeta a cambios en festivos. No determina el funcionamiento de la fuente ni garantiza acceso.'],
          ['Tiempo recomendado', '45–90 min', 'Para fuente, arte y fotografías. Reserva 2–3 h si enlazas con parques, universidad o Sabana Grande.'],
          ['Mejor momento', 'Tarde + inicio de noche', 'La luz diurna ayuda a leer el arte; la iluminación de la fuente gana protagonismo después del atardecer cuando está operativa.'],
          ['Baños', 'Sin verificación actual', 'No se ha comprobado la ubicación, apertura ni accesibilidad de sanitarios; confirma tus necesidades antes de salir.'],
          ['Accesibilidad', 'Entorno mayormente urbano', 'La estación y los cruces concentran flujos intensos. Prioriza salidas señalizadas, rampas disponibles y cruces peatonales formales.'],
          ['Estacionamiento', 'Comprueba una opción concreta', 'No se han verificado plazas disponibles ni tarifas. Revisa condiciones y señalización antes de dejar el vehículo.'],
          ['Seguridad urbana', 'Precauciones habituales', 'Es un nodo concurrido: mantén pertenencias controladas, evita obstaculizar cruces y consulta el estado del transporte antes del regreso.']
        ].map(([title, strong, text]) => (
          <article class="bg-paper p-6 md:p-7">
            <p class="text-xs font-bold uppercase tracking-[.13em] text-black/45">{title}</p>
            <strong class="display mt-3 block text-2xl">{strong}</strong>
            <p class="mt-3 text-sm leading-6 text-black/60">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="servicios" class="bg-[#e4ddd0] py-24">
    <div class="site-shell">
      <div class="max-w-3xl">
        <span class="eyebrow text-coral">Servicios y necesidades de la visita</span>
        <h2 class="display mt-5 text-[clamp(3rem,6vw,6rem)]">Qué puedes resolver cerca</h2>
        <p class="mt-5 text-lg leading-8 text-black/62">Orientación por necesidades, sin recomendar negocios concretos. La presencia y disponibilidad de cada servicio deben comprobarse.</p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {[
["Baños, agua y descanso","No se han verificado sanitarios abiertos, agua potable ni una red de bancos accesibles. Lleva agua y confirma los servicios que necesites antes de llegar."],
["Comida y bebida","Si necesitas comer, compara las opciones disponibles en el entorno y comprueba precios, horario y condiciones en cada establecimiento. Esta guía no recomienda un negocio concreto."],
["Alojamiento","Compara alojamiento por ubicación, condiciones de acceso y transporte real. No se han medido tiempos a pie desde hoteles ni confirmado categorías o plazas disponibles."],
["Compras y servicios cotidianos","Comprueba por separado tiendas, farmacias o cajeros que necesites. No se garantiza disponibilidad, cambio de moneda ni atención en este recorrido."],
["Combustible y recarga","Planifica el abastecimiento del vehículo antes de salir. No se ha verificado una estación de carga o combustible como servicio de la plaza."],
["Equipaje, movilidad y niños","No se han comprobado consignas, alquiler de vehículos ni un área infantil operativa. Lleva solo lo necesario y supervisa a los niños cerca del agua y del tráfico."],
["Salud y ayuda","Prepara los contactos de asistencia que correspondan a tu viaje. Esta guía no ha verificado un puesto médico ni una farmacia abierta a una distancia concreta."],
["Información local","Consulta avisos oficiales y personal identificado cuando esté disponible. No se garantiza un puesto turístico, mapas impresos ni atención policial en cada salida."]
        ].map(([title, text], i) => (
          <article class="relative overflow-hidden bg-white p-7 shadow-[0_15px_45px_rgba(23,33,31,.05)]">
            <span class="absolute right-5 top-4 display text-5xl text-black/[.07]">0{i + 1}</span>
            <h3 class="text-lg font-extrabold">{title}</h3>
            <p class="mt-3 text-sm leading-7 text-black/60">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="rutas" class="site-shell py-24">
    <div class="grid gap-12 lg:grid-cols-[.55fr_1.45fr]">
      <div>
        <span class="eyebrow text-cobalt">Propuestas de recorrido</span>
        <h2 class="display mt-5 text-[clamp(3rem,6vw,6rem)]">Elige según tu ritmo.</h2>
        <p class="mt-6 leading-8 text-black/62">
Tres enfoques y dos duraciones orientativas. Son ideas adaptables, no rutas medidas ni itinerarios accesibles certificados. Confirma los accesos y servicios de cualquier destino adicional.
        </p>
      </div>
      <div>
        <div class="grid gap-5 md:grid-cols-3">
          <article class="border border-black/10 bg-white p-7">
            <span class="text-[.7rem] font-bold uppercase tracking-[.14em] text-sun">Propuesta A · Familias</span>
            <h3 class="display mt-4 text-2xl">Pausas y supervisión.</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-black/65">
              <li>Como idea flexible, reserva dos o tres horas con descansos.</li>
              <li>Elige primero un acceso seguro; no se ha comprobado una salida con ascensor.</li>
              <li>Programa pausas según las necesidades del grupo y lleva agua.</li>
              <li>Evita el borde del agua, el calor intenso y los cruces inseguros.</li>
              <li>Si necesitas comer, comprueba por separado un lugar adecuado para tu familia.</li>
              <li>Haz fotografías desde los espacios permitidos y supervisa a los niños.</li>
            </ul>
          </article>
          <article class="border border-black/10 bg-white p-7 md:-translate-y-5">
            <span class="text-[.7rem] font-bold uppercase tracking-[.14em] text-cobalt">Propuesta B · Fotografía</span>
            <h3 class="display mt-4 text-2xl">Luz, color y movimiento.</h3>
            <ul class="mt-5 space-y-3 text-sm leading-7 text-black/65">
              <li>Dedica el tiempo que necesites; no se ha medido una distancia fija.</li>
              <li>Busca una vista de la fuente desde un paso autorizado, sin entrar en la calzada.</li>
              <li>Observa Fisicromía y Abra Solar con luz diurna y desde distintos puntos seguros.</li>
              <li>Para una visita al anochecer, confirma primero si la fuente está funcionando.</li>
              <li>Usa el trípode solo donde esté permitido y sin bloquear el paso.</li>
              <li>Protege el equipo de lluvia, viento y aglomeraciones.</li>
            </ul>
          </article>
          <article class="border border-black/10 bg-white p-7">
            <span class="text-[.7rem] font-bold uppercase tracking-[.14em] text-leaf">Propuesta C · Menor esfuerzo</span>
            <h3 class="display mt-4 text-2xl">Menos desplazamientos.</h3>
