---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteInfo } from '../data/site';
import Weather from '../components/Weather.astro';

const days = [
  'https://schema.org/Monday',
  'https://schema.org/Tuesday',
  'https://schema.org/Wednesday',
  'https://schema.org/Thursday',
  'https://schema.org/Friday',
  'https://schema.org/Saturday',
  'https://schema.org/Sunday'
];

const siteUrl = 'https://plazavenezuela.org';
const attractionId = `${siteUrl}/#attraction`;
const websiteId = `${siteUrl}/#website`;
const webpageId = `${siteUrl}/#webpage`;

const attractionSchema = {
  '@id': attractionId,
  '@type': ['TouristAttraction', 'LandmarkOrHistoricalBuilding', 'Park'],
  name: 'Plaza Venezuela',
  alternateName: ['Plaza Venezuela', 'Caracas Plaza Venezuela', 'Plaza Venezuela Caracas', 'Fuente de Plaza Venezuela', 'Plaza Venezuela de Caracas', 'Plaza vzla', 'Plaza whats on Caracas', 'Plaza Venezuela en Caracas', 'Plaza de Venezuela', 'Plaza la Castellana Caracas'],
  description: 'Guía completa del visitante a Plaza Venezuela en Caracas, Distrito Capital, Venezuela: historia, arte cinético, fuente, clima, rutas y consejos.',
  url: `${siteUrl}/`,
  image: [
    siteInfo.photos.panorama.src,
    siteInfo.photos.fisicromia.src,
    siteInfo.photos.abraSolar.src
  ],
  isAccessibleForFree: true,
  publicAccess: true,
  telephone: siteInfo.phone,
  identifier: {
    '@type': 'PropertyValue',
    name: 'Plus Code',
    value: siteInfo.seo.plusCode
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Entrada', value: 'Gratuita' },
    { '@type': 'PropertyValue', name: 'Horario habitual', value: siteInfo.hours },
    { '@type': 'PropertyValue', name: 'Estación de Metro más cercana', value: siteInfo.seo.nearStation }
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteInfo.streetAddress,
    addressLocality: siteInfo.locality,
    addressRegion: siteInfo.region,
    postalCode: siteInfo.postalCode,
    addressCountry: siteInfo.countryCode
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteInfo.latitude,
    longitude: siteInfo.longitude
  },
  hasMap: siteInfo.mapsUrl,
  sameAs: [
    siteInfo.mapsUrl,
    siteInfo.govtTourismUrl,
    'https://www.wikidata.org/wiki/Q6079839',
    'https://es.wikipedia.org/wiki/Plaza_Venezuela',
    'https://en.wikipedia.org/wiki/Plaza_Venezuela',
    'https://www.google.com/maps?cid=10051477241080980428'
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: siteInfo.rating,
    ratingCount: siteInfo.ratingCount,
    bestRating: 5,
    worstRating: 1
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: days,
    opens: '06:00',
    closes: '21:00'
  }]
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: `${siteUrl}/`,
  name: 'Plaza Venezuela · Guía Turística Caracas',
  alternateName: [
    'Guía de Plaza Venezuela, Caracas',
    'Plaza vzla',
    'Plaza whats on Caracas',
    'Plaza Venezuela Caracas Travel Guide'
  ],
  description: 'Guía independiente sin fines de lucro para visitar Plaza Venezuela en Caracas: ubicación exacta Av. Casanova (Plus Code F4W7+MMM), cómo llegar en Metro, historia de la fuente iluminada y obras de arte cinético.',
  inLanguage: 'es-VE'
};

const webpageSchema = {
  '@type': 'WebPage',
  '@id': webpageId,
  url: `${siteUrl}/`,
  name: siteInfo.seo.title,
  description: siteInfo.seo.description,
  isPartOf: {
    '@id': websiteId
  },
  about: {
    '@id': attractionId
  },
  mainEntity: {
    '@id': attractionId
  },
  inLanguage: 'es-VE',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Plaza Venezuela', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Caracas', item: `${siteUrl}/#caracas` },
      { '@type': 'ListItem', position: 3, name: 'Distrito Capital', item: `${siteUrl}/#distrito-capital` },
      { '@type': 'ListItem', position: 4, name: 'Venezuela', item: `${siteUrl}/#venezuela` }
    ]
  }
};

const faqs = [
  {
    q: 'Where is Plaza Venezuela located?',
    a: 'Plaza Venezuela is located in Caracas, Distrito Capital, Venezuela. The full address is F4W7+MMM, Av. Casanova, Caracas 1052, Distrito Capital, Venezuela.'
  },
  {
    q: 'Is Plaza Venezuela free to visit?',
    a: 'Yes, Plaza Venezuela is a public space and is free to visit year-round. No entrance ticket is required.'
  },
  {
    q: '¿La entrada a Plaza Venezuela es gratuita?',
    a: 'Sí. Es un espacio público y no requiere boleto de entrada. El transporte, el estacionamiento y cualquier consumo en los alrededores se pagan por separado.'
  },
  {
    q: '¿Cuál es el horario de Plaza Venezuela?',
    a: 'Las referencias de ubicación consultadas muestran un horario habitual de 6:00 a 21:00 para la fuente y la plaza. La operación de la fuente, los eventos y algunos accesos pueden variar; conviene comprobar las condiciones del día antes de ir.'
  },
  {
    q: '¿Cómo se llega en Metro?',
    a: 'La estación Plaza Venezuela es el acceso más directo. Es un nodo de conexión de las líneas 1 y 3, con enlace hacia la Línea 4 por Zona Rental. Utiliza las salidas señalizadas hacia Plaza Venezuela y la fuente.'
  },
  {
    q: '¿Hay baños públicos?',
    a: 'En el entorno inmediato se han incorporado sanitarios públicos en áreas recreativas adyacentes. Su disponibilidad y horario pueden cambiar, por lo que es recomendable confirmar el acceso al llegar.'
  },
  {
    q: '¿Cuánto tiempo conviene dedicar a la visita?',
    a: 'Entre 45 y 90 minutos permiten recorrer la fuente y las principales obras de arte público. Si se combina con Los Caobos, el Jardín Botánico, la Ciudad Universitaria o Sabana Grande, conviene reservar de dos a tres horas.'
  },
  {
    q: '¿Cuál es el mejor momento para visitar?',
    a: 'La tarde ofrece buena luz para apreciar el arte cinético; el inicio de la noche permite ver la iluminación de la fuente cuando está operativa. Para una lectura más detallada de las obras, la luz diurna es preferible.'
  }
];

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};

const structuredData = [attractionSchema, websiteSchema, webpageSchema, faqSchema];

const pageTitle = siteInfo.seo.title;
const pageDescription = siteInfo.seo.description;
const pageKeywords = siteInfo.seo.keywords;
const ogTitle = pageTitle;
const ogDescription = pageDescription;
const canonicalUrl = 'https://plazavenezuela.org/';

const seasonalTableRows = [
  ['1 月', '温暖干燥，日间 24–29°C', '旱季初，午后基本无雨', '短袖 + 薄外套（空调房）', '喷泉夜景、都市步行', '下午阳光柔和，光影长', '干季少雨，喷泉稳定', '防晒！1 月紫外线仍强'],
  ['2 月', '偏热，偶达 30°C', '极少降雨，空气略干', '短袖 + 遮阳帽', 'Sabana Grande 步行街、Los Caobos', '日落偏早，黄金时刻紧凑', '喷泉表演人流高峰', '补水，建议早晚出游'],
  ['3 月', '全年最热月份之一', '旱季尾声，雷雨极少', '轻薄吸汗、防晒全套', '清晨摄影 + 夜间喷泉', '清晨蓝天通透', '阿维拉山轮廓清晰，夜景好', '正午暴晒，儿童不宜久留'],
