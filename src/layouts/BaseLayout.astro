---
import '../styles/global.css';
import { siteInfo } from '../data/site';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  ogLocaleAlternates?: string[];
  hreflangs?: Array<{ hreflang: string; href: string }>;
  sitemapUrl?: string;
}

const DEFAULT_OG_ALTERNATES: string[] = [];

const {
  title = siteInfo.name,
  description = siteInfo.description,
  keywords = undefined,
  image = siteInfo.photos.panorama.src,
  imageAlt = siteInfo.photos.panorama.alt,
  canonical: canonicalProp,
  structuredData,
  noindex = false,
  ogLocaleAlternates = DEFAULT_OG_ALTERNATES,
  hreflangs,
  sitemapUrl = 'https://plazavenezuela.org/sitemap-index.xml'
} = Astro.props;

const displayTitle = title.includes('Plaza Venezuela') ? title : title + ' | ' + siteInfo.name;
const siteBase = Astro.site?.origin || 'https://plazavenezuela.org';
const effectiveCanonical =
  canonicalProp ||
  (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined) ||
  `${siteBase}${Astro.url.pathname}`;

const absoluteImage = Astro.site && image.startsWith('/') ? new URL(image, Astro.site).href : image;
const schemaNodes = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];

const webSiteNode = {
  '@type': 'WebSite',
  name: siteInfo.name,
  description: siteInfo.description,
  inLanguage: 'es-VE',
  '@id': `${siteBase}/#website`,
  url: `${siteBase}/`
};

const hasWebSiteNode = schemaNodes.some((node) => {
  const nodeType = node['@type'];
  return nodeType === 'WebSite' || (Array.isArray(nodeType) && nodeType.includes('WebSite'));
});

const schemaPayload = schemaNodes.length
  ? { '@context': 'https://schema.org', '@graph': hasWebSiteNode ? schemaNodes : [...schemaNodes, webSiteNode] }
  : { '@context': 'https://schema.org', ...webSiteNode };

const finalHreflangs = hreflangs && hreflangs.length
  ? hreflangs
  : [
      { hreflang: 'es-VE', href: effectiveCanonical },
      { hreflang: 'x-default', href: effectiveCanonical }
    ];
---
<!doctype html>
<html lang="es-VE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#17211f" />
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{displayTitle}</title>
    {effectiveCanonical && <link rel="canonical" href={effectiveCanonical} />}
    {sitemapUrl && <link rel="sitemap" type="application/xml" title="Sitemap" href={sitemapUrl} />}
    {finalHreflangs.map((h) => (
      <link rel="alternate" hreflang={h.hreflang} href={h.href} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:locale" content="es_VE" />
    {ogLocaleAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    {effectiveCanonical && <meta property="og:url" content={effectiveCanonical} />}
    {absoluteImage && <meta property="og:image" content={absoluteImage} />}
    {absoluteImage && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:site_name" content={siteInfo.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={description} />
    {absoluteImage && <meta name="twitter:image" content={absoluteImage} />}
    {absoluteImage && <meta name="twitter:image:alt" content={imageAlt} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaPayload)}></script>
    <slot name="head" />
    <script is:inline src="/consent.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="sticky top-0 z-40 border-b border-black/10 bg-paper/95 backdrop-blur">
      <div class="site-shell flex min-h-18 items-center justify-between gap-6 py-3">
        <Logo />
        <nav class="hidden items-center gap-5 text-[.78rem] font-bold uppercase tracking-[.08em] lg:flex" aria-label="Navegación principal">
          <a href="/#historia" class="hover:opacity-55">Historia</a>
          <a href="/#arte" class="hover:opacity-55">Arte</a>
          <a href="/#visita" class="hover:opacity-55">Planifica</a>
          <a href="/#como-llegar" class="hover:opacity-55">Cómo llegar</a>
          <a href="/#mapa" class="hover:opacity-55">Mapa</a>
        </nav>
        <a href="/#visita" class="rounded-full bg-ink px-4 py-2 text-xs font-bold uppercase tracking-[.08em] text-white hover:bg-cobalt" style="color: #ffffff !important;">Guía de visita</a>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
