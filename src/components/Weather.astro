---
import { siteInfo } from '../data/site';
const site = siteInfo;
const CACHE_KEY = 'pv-weather-forecast-v2';
const TTL_MS = 20 * 60 * 1000;
const LAT = 10.4967;
const LON = -66.8884;
const TZ = 'America%2FCaracas';

const _weatherCache =
  (globalThis as any).__PV_WEATHER_CACHE__ ||
  ((globalThis as any).__PV_WEATHER_CACHE__ = new Map<string, { ts: number; data: any }>());

const now = Date.now();
const cached = _weatherCache.get(CACHE_KEY);
let payload: any = null;
let ok = false;

if (cached && now - cached.ts < TTL_MS) {
  payload = cached.data;
  ok = true;
} else {
  const qs =
    `latitude=${LAT}&longitude=${LON}` +
    `&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m,wind_direction_10m` +
    `&daily=temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,weather_code,wind_speed_10m_max,uv_index_max,sunrise,sunset` +
    `&timezone=${TZ}&forecast_days=7`;
  try {
    const res = await fetch(`https://api.open-meteo.com/v1/forecast?${qs}`, {
      headers: { Accept: 'application/json' }
    });
    if (res.ok) {
      const data = await res.json();
      _weatherCache.set(CACHE_KEY, { ts: now, data });
      payload = data;
      ok = true;
    }
  } catch {
    ok = false;
  }
}

const humidityLabel = (h: number) =>
  h < 50 ? '干燥舒适' : h <= 70 ? '体感适中' : '潮湿闷热';
const uvLabel = (u: number) =>
  u < 3 ? '温和，可长时间户外' : u <= 6 ? '中等偏强，建议防晒' : '很强，避开正午直晒';
const windLabel = (s: number) =>
  s < 5 ? '微风' : s <= 15 ? '有风，体感凉爽' : s <= 29 ? '风较大，注意裙摆帽子' : s <= 49 ? '风偏大，注意收束衣物' : '大风，远离悬挂物与广告牌';
const tempLabel = (t: number) =>
  t < 10 ? '寒冷，注意保暖' : t < 15 ? '微凉，备厚外套' : t <= 22 ? '舒适' : t <= 28 ? '温暖偏热' : t <= 32 ? '偏热' : '炎热，多喝水';
const weatherIcon = (c: number) => {
  if (c === 0) return '☀️';
  if (c >= 1 && c <= 3) return c === 3 ? '☁️' : '⛅';
  if (c >= 45 && c <= 48) return '🌫️';
  if (c >= 51 && c <= 67) return c >= 61 ? '🌧️' : '🌦️';
  if (c >= 71 && c <= 86) return '❄️';
  if (c >= 95 && c <= 99) return '⛈️';
  return '🌤️';
};
const weatherText = (c: number) => {
  if (c === 0) return '晴朗';
  if (c === 1) return '大部晴朗';
  if (c === 2) return '局部多云';
  if (c === 3) return '阴天';
  if (c >= 45 && c <= 48) return '雾或轻霾';
  if (c >= 51 && c <= 55) return '毛毛雨';
  if (c >= 56 && c <= 57) return '冻毛毛雨';
  if (c >= 61 && c <= 65) return '阵雨';
  if (c >= 66 && c <= 67) return '冻雨';
  if (c >= 71 && c <= 77) return '阵雪';
  if (c >= 80 && c <= 82) return '强阵雨';
  if (c >= 85 && c <= 86) return '强阵雪';
  if (c === 95) return '雷暴';
  if (c >= 96 && c <= 99) return '雷暴伴冰雹';
  return '天气多变';
};
const pad = (n: number) => (n < 10 ? `0${n}` : `${n}`);
const weekDayNames = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
const monthNames = ['1 月', '2 月', '3 月', '4 月', '5 月', '6 月', '7 月', '8 月', '9 月', '10 月', '11 月', '12 月'];

const formatDateStr = (iso: string) => {
  const d = new Date(iso + 'T00:00:00');
  return `${pad(d.getMonth() + 1)}/${pad(d.getDate())}`;
};
const formatTimeStr = (iso: string) => {
  const d = new Date(iso);
  return `${pad(d.getHours())}:${pad(d.getMinutes())}`;
};
const weekDayName = (iso: string) => {
  const d = new Date(iso + 'T00:00:00');
  return weekDayNames[d.getDay()];
};

const buildBadges = (current: any, todayDaily: any) => {
  const list: Array<{ icon: string; text: string; label: string }> = [];
  const precip = typeof current?.precipitation === 'number' ? current.precipitation : 0;
  const prob = todayDaily?.precipitation_probability_max ?? 0;
  const uv = todayDaily?.uv_index_max ?? 0;
  const tmin = todayDaily?.temperature_2m_min ?? 99;
  const tmax = todayDaily?.temperature_2m_max ?? -99;
  if (precip > 0.1 || prob > 40) list.push({ icon: '☔', text: '记得带伞', label: '今日降水概率较高，出行带伞' });
  if (uv >= 6) list.push({ icon: '🧴', text: '加强防晒', label: '紫外线强烈，建议帽子、墨镜与防晒霜' });
  if (tmin < 16) list.push({ icon: '🧥', text: '备薄外套', label: '早晚微凉，室内或车内建议备一件' });
  if (tmax > 28) list.push({ icon: '💧', text: '多喝水', label: '天气偏热，注意补水，避开正午暴晒' });
  if (list.length === 0) list.push({ icon: '✨', text: '天气不错', label: '今日适合户外活动' });
  return list;
};

const FALLBACK = {
  temp: 24,
  humidity: 65,
  wind: 8,
  uv: 7,
  code: 2,
  precip: 0,
  summary: '加拉加斯常年干湿分明，11 月至次年 4 月多为晴朗干燥；5 月至 10 月午后偶有阵雨。建议出行前关注当日时段预报。',
  tmax: 29,
  tmin: 19,
  precipProbMax: 35,
  sunrise: '06:30',
  sunset: '18:45'
};

const currentRaw = ok && payload?.current;
const dailyRaw = ok && payload?.daily;

const current = {
  t: Math.round(currentRaw?.temperature_2m ?? FALLBACK.temp),
  apparent: Math.round(currentRaw?.apparent_temperature ?? FALLBACK.temp),
  humidity: Math.round(currentRaw?.relative_humidity_2m ?? FALLBACK.humidity),
  wind: Math.round(currentRaw?.wind_speed_10m ?? FALLBACK.wind),
  windDir: currentRaw?.wind_direction_10m ?? 0,
  precip: typeof (currentRaw?.precipitation) === 'number' ? currentRaw.precipitation : FALLBACK.precip,
  code: currentRaw?.weather_code ?? FALLBACK.code
};
const todayDaily = dailyRaw
  ? {
      tmax: Math.round(dailyRaw.temperature_2m_max[0]),
      tmin: Math.round(dailyRaw.temperature_2m_min[0]),
      precipSum: dailyRaw.precipitation_sum[0],
      precipProbMax: dailyRaw.precipitation_probability_max[0],
      uv: dailyRaw.uv_index_max[0],
      sunrise: formatTimeStr(dailyRaw.sunrise[0]),
      sunset: formatTimeStr(dailyRaw.sunset[0]),
      code: dailyRaw.weather_code[0]
    }
  : {
      tmax: FALLBACK.tmax,
      tmin: FALLBACK.tmin,
      precipSum: 0,
      precipProbMax: FALLBACK.precipProbMax,
      uv: FALLBACK.uv,
      sunrise: FALLBACK.sunrise,
      sunset: FALLBACK.sunset,
      code: FALLBACK.code
    };

const badges = buildBadges(
  { precipitation: current.precip, ...current },
  todayDaily
);

type AdviceCtx = {
  current: typeof current;
  today: typeof todayDaily;
};
const buildAdviceEngine = (ctx: AdviceCtx) => {
  const risks: string[] = [];
  const outfits: string[] = [];
  const activities: string[] = [];
  const carries: string[] = [];

  const c = ctx.current;
  const t = ctx.today;
  const code = c.code;
  const precip = c.precip;
  const prob = t.precipProbMax;
  const tmax = t.tmax;
  const tmin = t.tmin;
  const uv = t.uv;
  const wind = c.wind;
  const humidity = c.humidity;
  const diff = tmax - tmin;

  // --- 合成预警类（优先级最高，写在 risks 第一条）---
  if ((code >= 95 && code <= 99) || wind >= 50 || (prob >= 85 && precip >= 8)) {
    risks.push(
      '【⚠️ 天气风险提醒】今日存在雷暴、大风或强降雨的潜在风险，建议灵活调整行程，优先地铁站、Sabana Grande 室内步行街和 UCV 室内走廊等封闭环境，不要前往山区或环形路口低洼地带，密切关注实时变化。'
    );
  }

  // --- 降水类 ---
  if (prob >= 60) {
    outfits.push('防水外套或带帽子的冲锋衣优先，避免只穿棉质 T 恤淋雨后贴身发黏');
    activities.push('大概率会下雨，露天喷泉观赏体验较差，优先 Sabana Grande 室内走廊、地铁站厅或博物馆等有遮蔽的空间');
    carries.push('☂️ 折叠伞或轻便雨衣（两种都带更好，广场环形天桥上风大时长柄伞不好握）');
  }
  if ((code >= 51 && code <= 55) || (precip > 0 && precip < 2)) {
    outfits.push('路面湿滑，建议穿防滑鞋，不建议穿凉鞋走环形路口积水带');
    activities.push('有小雨，喷泉水雾感更强但手机/相机镜头容易沾水汽，记得带一块镜头布');
    carries.push('☂️ 折叠伞（放包里随手可用）');
  }
  if ((code >= 61 && code <= 82) || precip >= 5) {
    risks.push('⚠️ 降雨较强，注意避开环形路口地下通道入口、人行道低洼积水带，尽量选择高处过街');
    outfits.push('优先穿防水外套和防水裤脚；别穿浅色衣裤，泥点显眼');
    activities.push('不建议长时间户外步行，Los Caobos 公园林荫路雨后泥泞；可转往 UCV 走廊或 Sabana Grande 室内步行街');
    carries.push('🧥 雨衣（比长柄伞更靠谱，广场环形天桥上风大时长柄伞容易翻折）');
  }
  if (code >= 95 && code <= 99) {
    risks.push('⚠️ 谨防雷电，不要在环形人行天桥开阔处、喷泉核心平台、单独大树下避雨；立刻进入地铁站或有顶建筑');
    activities.push('户外喷泉灯光秀体验很差且不安全；优先 Sabana Grande 室内、UCV 走廊、购物中心等封闭空间');
    carries.push('🔌 若携带无人机、相机云台立刻断电收包，不要在空旷处开机');
  }
  if (prob >= 40 && prob < 60) {
    activities.push('有一定降雨可能，行程预留 20% 机动时间，万一赶上雨就进地铁站厅躲 20 分钟一般就停了');
    carries.push('☂️ 备一把折叠伞（不下雨也不重）');
  }

  // --- 高温 & 紫外线 ---
  if (tmax >= 32) {
    outfits.push('气温偏高，优先轻薄透气的速干面料，避免深色（黑/深蓝在喷泉广场直晒下很热）');
    activities.push('缩短正午 (12:00-14:30) 户外连续停留，这段时间转 UCV 走廊、室内博物馆、地铁站空调区更舒服');
    carries.push('💧 多备 1 瓶水，广场直饮水点仅周边有；随身防暑用品');
  }
  if (uv >= 5) {
    outfits.push('紫外线较强，长袖防晒衬衫、薄披肩、防晒面罩都管用，环形天桥长曝更要遮脸');
    activities.push('若在环形天桥、喷泉开阔平台长时间拍照，每隔 20 分钟躲一次阴凉；别在正午露天拍 Abra Solar');
    carries.push('🧴 防晒霜 SPF50+（出门前 15 分钟涂）、墨镜、宽檐遮阳帽');
  }
  if (tmax >= 28 && tmax < 32 && humidity >= 75) {
    outfits.push('潮湿闷热，身上容易发黏，建议速干面料避免纯棉贴身');
    carries.push('💧 多备 1 瓶水，喷泉夜景时段前后体感温差大可以随时补');
  }

  // --- 低温 & 昼夜温差 ---
  if (diff > 8) {
    outfits.push('昼夜温差大，短袖加衬衫/薄外套的叠穿最灵活；傍晚看喷泉灯光记得披上');
    carries.push('🧥 包里放一件薄外套（傍晚 18:30–20:30 喷泉灯光前后常用）');
  }
  if (tmax <= 10) {
    outfits.push('气温偏低，厚外套加围巾，老人儿童减少户外连续时间');
    activities.push('户外停留每 40 分钟进地铁站或有顶建筑回暖一次');
    carries.push('🧣 厚围巾 + 便携暖贴（若有）');
  }
  if (tmin <= 16 && tmax <= 22) {
    outfits.push('微凉，衬衫加薄外套组合最合适，单穿短袖在喷泉天桥会冷');
  }

  // --- 风力类（km/h，5 级约 29-38，6 级约 39-49，7 级 ≥50）---
  if (wind >= 29 && wind < 39) {
    outfits.push('帽子容易吹落，渔夫帽建议加绳；紧身棒球帽更稳');
    activities.push('环形天桥上风偏大，拍照时别离护栏太近；三脚架若是轻型号请挂重物');
  }
  if (wind >= 39 && wind < 50) {
    outfits.push('不建议穿宽松长裙或宽袖口衬衫，容易被风吹翻走光');
    activities.push('摄影三脚架需要在中轴挂钩上挂重物（装了水的袋子就行）；Abra Solar 附近风噪较大');
    carries.push('🧢 帽子 + 眼镜绳固定（风一吹就飞的东西都要绑）');
  }
  if (wind >= 50) {
    risks.push('⚠️ 大风天气，远离环形路口的户外广告牌、天桥横幅、临时围挡；不要靠近悬挂物正下方');
    activities.push('Abra Solar 叶片旋转速度快噪音大，不建议长时停留；摄影取消长曝计划');
    outfits.push('外套全部扣好/拉链拉到顶，避免被风掀开；长发尽量扎起来');
  }
  if (wind >= 15 && wind < 29) {
    outfits.push('有风体感凉爽，薄外套比单件短袖舒服，喷泉天桥上尤其明显');
  }

  // --- 晴阴类 ---
  if (code === 0) {
    outfits.push('阳光极好，浅色（米白/浅蓝）衣物在喷泉照片里更出片');
    activities.push('最适合环形天桥日出日落全景 + 蓝调时刻（日落后 15-30 分钟）喷泉灯光长曝三脚架');
    carries.push('🧴 防晒别忘了补涂（出汗/纸巾擦过就要补）');
  }
  if (code >= 1 && code <= 2) {
    activities.push('光线柔和不顶光，是一天里拍 Abra Solar 金属质感、Fisicromía 彩色条纹的最佳窗口');
  }
  if (code === 3) {
    outfits.push('不晒不闷，穿什么都很舒服');
    activities.push('无暴晒适合长时间户外步行：Los Caobos 公园 → Jardín Botánico → 回广场，单程大约 2 小时');
    carries.push('☂️ 背包里塞一把折叠伞以防万一（阴转阵雨在加拉加斯很常见）');
  }

  // --- 雾/霾类 ---
  if (code >= 45 && code <= 48) {
    risks.push('⚠️ 能见度下降，环形天桥远眺 Avila 山远景体验差，改看建筑细节或室内景点');
    activities.push('观景体验较差，优先 Sabana Grande 建筑立面细节、UCV 现代主义走廊、博物馆等近距离景点');
    carries.push('😷 敏感人群带口罩（呼吸道或过敏体质）');
  }

  // --- 地理场景扩展 ---
  // 场景 B：邻接绿地森林 Los Caobos / Jardín Botánico
  if (humidity > 70 && tmax >= 24) {
    carries.push('🦟 若去 Los Caobos 或 Jardín Botánico 林荫区，随身带驱蚊液或防蚊贴（树荫下蚊虫较多）');
  }
  if ((code >= 51 && code <= 65) || (precip > 0 && precip < 5)) {
    activities.push('🎯 Los Caobos 公园林荫小径雨后泥泞，建议穿防滑鞋，尽量别走土路');
  }
  // 场景 C：沿海大都会（距海岸 ~25km）
  if (uv >= 7 && tmax >= 28) {
    activities.push('🏖️ 若当日驱车前往海岸，海面紫外线反射比陆地更强；回到 Plaza Venezuela 的喷泉夜景时段，体感会比正午凉爽很多');
  }
  if (wind >= 29) {
    outfits.push('🧢 无论在广场或海岸，今天宽檐帽都需要固定绳，一吹就飞');
  }
  // 场景 A：城市广场常驻（命中任何一种天气都植入少量专属名词）
  if (prob >= 40 || wind >= 29 || tmax >= 28 || code === 0 || code === 3) {
    activities.push('🎯 喷泉夜景观赏（约日落前后 1 小时）：若今天天气好可提前半小时到环形天桥占位；若下雨或大风，则改 Sabana Grande 室内步行街晚餐更稳');
  }

  // --- 去重 ---
  return {
    risks: Array.from(new Set(risks)),
    outfits: Array.from(new Set(outfits)),
    activities: Array.from(new Set(activities)),
    carries: Array.from(new Set(carries))
  };
};

const { risks, outfits, activities, carries } = buildAdviceEngine({ current, today: todayDaily });

const weekDays = [];
if (dailyRaw && ok) {
  const n = Math.min(7, dailyRaw.time.length);
  for (let i = 0; i < n; i++) {
    const iso = dailyRaw.time[i];
    const duv = dailyRaw.uv_index_max[i];
    const dprob = dailyRaw.precipitation_probability_max[i];
    const dtmax = Math.round(dailyRaw.temperature_2m_max[i]);
    const dtmin = Math.round(dailyRaw.temperature_2m_min[i]);
    let tip = '适合出行';
    if (dprob > 60) tip = '午后大概率有雨';
    else if (duv > 8) tip = '阳光强烈，注意防晒';
    else if (dtmax > 30) tip = '炎热，建议早起或傍晚游览';
    else if (dtmin < 16) tip = '早晚微凉';
    weekDays.push({
      date: formatDateStr(iso),
      weekday: weekDayName(iso),
      icon: weatherIcon(dailyRaw.weather_code[i]),
      condition: weatherText(dailyRaw.weather_code[i]),
      tmax: dtmax,
      tmin: dtmin,
      prob: dprob,
      uv: duv,
      sunrise: formatTimeStr(dailyRaw.sunrise[i]),
      sunset: formatTimeStr(dailyRaw.sunset[i]),
      tip
    });
  }
}

const updatedLabel = (() => {
  const d = new Date();
  return `${pad(d.getHours())}:${pad(d.getMinutes())} 更新（每 20 分钟刷新一次）`;
})();
