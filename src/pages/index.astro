  ['8 月', '闷热回归', '午后阵雨概率高', '透气、吸汗、防晒', '早 8 点前逛完 + 夜游', '强烈顶光，避免 11-14 点拍', '夜游黄金档，人多热闹', '暑期人潮，看好小朋友'],
  ['9 月', '典型湿季', '连续性降水常见', '雨具、防蚊液', '地铁直达 + 室内文化中心', '漫射光最柔，色彩准确', '雨中喷泉的氛围感摄影', '蚊虫在雨后增多'],
  ['10 月', '湿季尾声，仍多雨', '降雨概率最高月之一', '防水背包 + 鞋', '躲雨时段：餐饮与商业走廊', '天光色温偏低，电影感', '长曝光拍雨丝与喷泉', '注意随身电子设备防潮'],
  ['11 月', '干爽回归', '降雨锐减，天转晴', '短袖 + 薄外套', '全户外串联：Los Caobos + plaza', '黄金时刻变长', '喷泉夜景回稳，游客减少', '完美过渡季，首推出行月'],
  ['12 月', '全年最佳天气', '几乎无雨、空气清新', '薄外套 + 防晒', '节日氛围广场、夜景、圣诞灯', '傍晚蓝调时间长', '年终庆典灯饰叠加喷泉', '圣诞周人多，提前到达']
