<section id="clima" class="bg-mist/80 py-24">
  <div class="site-shell grid gap-12 lg:grid-cols-[.72fr_1.28fr]">
    <div>
      <span class="eyebrow text-cobalt">今日出行</span>
      <h2 class="display mt-5 text-[clamp(3rem,6vw,5.8rem)]">Caracas，现在的天气。</h2>
      {ok ? (
        <p class="mt-6 leading-8 text-black/62">
          体感 <strong>{tempLabel(current.apparent)}</strong>。湿度
          <strong> {humidityLabel(current.humidity)}</strong>，{windLabel(current.wind)}。紫外线
          <strong> {uvLabel(todayDaily.uv)}</strong>。
          喷泉夜游时段：建议在日落前后到达，灯光与天色交接时视觉最丰富。
        </p>
      ) : (
        <p class="mt-6 leading-8 text-black/62">{FALLBACK.summary}</p>
      )}
      <p class="mt-4 text-xs text-black/45">{updatedLabel}</p>
    </div>

    <div class="space-y-6">
      <article class="overflow-hidden rounded-[1.5rem] border border-black/10 bg-white shadow-[0_25px_80px_rgba(23,33,31,.1)]">
        <div class="grid gap-6 p-7 md:grid-cols-[1fr_1.1fr] md:p-9">
          <div>
            <div class="flex items-end gap-4">
              <span class="text-6xl">{weatherIcon(current.code)}</span>
              <div>
                <p class="text-xs font-bold uppercase tracking-[.14em] text-black/45">Plaza Venezuela</p>
                <p class="mt-1 text-sm text-black/55">Caracas · {site.region}</p>
              </div>
            </div>
            <div class="mt-6 flex items-baseline gap-3">
              <strong class="display text-[clamp(4rem,10vw,6.6rem)] leading-none">{current.t}°</strong>
              <span class="text-sm text-black/55">体感 {current.apparent}°</span>
            </div>
            <p class="mt-3 text-lg font-extrabold">{weatherText(current.code)}</p>
            <p class="mt-2 text-sm text-black/60">
              {todayDaily.tmax}° / {todayDaily.tmin}° · {todayDaily.sunrise} 日出 · {todayDaily.sunset} 日落
            </p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="rounded-xl border border-black/10 bg-paper p-4">
              <p class="text-[.7rem] font-bold uppercase tracking-[.14em] text-black/45">湿度</p>
              <p class="mt-2 text-sm leading-6">
                <strong class="text-base">{current.humidity}%</strong> · {humidityLabel(current.humidity)}
              </p>
            </div>
            <div class="rounded-xl border border-black/10 bg-paper p-4">
              <p class="text-[.7rem] font-bold uppercase tracking-[.14em] text-black/45">风</p>
              <p class="mt-2 text-sm leading-6">
                <strong class="text-base">{current.wind} km/h</strong> · {windLabel(current.wind)}
              </p>
            </div>
            <div class="rounded-xl border border-black/10 bg-paper p-4">
              <p class="text-[.7rem] font-bold uppercase tracking-[.14em] text-black/45">降水概率</p>
              <p class="mt-2 text-sm leading-6">
                <strong class="text-base">{todayDaily.precipProbMax}%</strong> ·{' '}
                {todayDaily.precipProbMax < 30 ? '基本不用带伞' : todayDaily.precipProbMax < 60 ? '建议备折叠伞' : '雨具必带'}
              </p>
            </div>
            <div class="rounded-xl border border-black/10 bg-paper p-4">
              <p class="text-[.7rem] font-bold uppercase tracking-[.14em] text-black/45">紫外线</p>
              <p class="mt-2 text-sm leading-6">
                <strong class="text-base">UV {todayDaily.uv.toFixed(1)}</strong> · {uvLabel(todayDaily.uv)}
              </p>
            </div>
          </div>
        </div>
        <div class="flex flex-wrap gap-3 border-t border-black/10 bg-white/60 p-6 md:px-9">
          {badges.map((b) => (
            <span
              class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-4 py-2 text-sm font-bold"
              aria-label={b.label}
            >
              <span aria-hidden="true">{b.icon}</span>
              <span>{b.text}</span>
            </span>
          ))}
        </div>
      </article>

      {risks.length > 0 && (
        <article class="rounded-[1.5rem] border border-red-300 bg-red-50 p-6 md:p-7 text-red-800 shadow-[0_18px_50px_rgba(200,30,30,.12)]">
          <h3 class="text-lg font-extrabold mb-3">⚠️ 风险提醒</h3>
          <ul class="space-y-2 text-sm leading-7">
            {risks.map((r) => <li class="pl-1">{r}</li>)}
          </ul>
        </article>
      )}

      {outfits.length > 0 && (
        <article class="rounded-[1.5rem] border border-black/10 bg-white p-6 md:p-7 shadow-[0_20px_60px_rgba(23,33,31,.07)]">
          <h3 class="text-lg font-extrabold mb-3">✅ 出行穿搭</h3>
          <ul class="space-y-2 text-sm leading-7 text-black/70">
            {outfits.map((o) => <li>👕 {o}</li>)}
          </ul>
        </article>
      )}

      {activities.length > 0 && (
        <article class="rounded-[1.5rem] border border-black/10 bg-white p-6 md:p-7 shadow-[0_20px_60px_rgba(23,33,31,.07)]">
          <h3 class="text-lg font-extrabold mb-3">✅ 游玩安排</h3>
          <ul class="space-y-2 text-sm leading-7 text-black/70">
            {activities.map((a) => <li>🎯 {a}</li>)}
          </ul>
        </article>
      )}

      {carries.length > 0 && (
        <article class="rounded-[1.5rem] border border-black/10 bg-white p-6 md:p-7 shadow-[0_20px_60px_rgba(23,33,31,.07)]">
          <h3 class="text-lg font-extrabold mb-3">🎒 随身物品</h3>
          <ul class="space-y-2 text-sm leading-7 text-black/70">
            {carries.map((c) => <li>{c}</li>)}
          </ul>
        </article>
      )}

      {weekDays.length > 0 && ok && (
        <div class="overflow-hidden rounded-[1.5rem] border border-black/10 bg-white shadow-[0_25px_80px_rgba(23,33,31,.08)]">
          <div class="overflow-x-auto">
            <table class="w-full min-w-[720px] border-collapse text-sm">
              <caption class="px-6 pt-6 pb-3 text-left text-xs font-bold uppercase tracking-[.14em] text-black/45">
                未来 7 天预报 · Plaza Venezuela
              </caption>
              <thead class="bg-paper text-black/70">
                <tr>
                  <th scope="col" class="px-4 py-3 text-left">日期</th>
                  <th scope="col" class="px-4 py-3 text-left">天气</th>
                  <th scope="col" class="px-4 py-3 text-left">气温</th>
                  <th scope="col" class="px-4 py-3 text-left">降水</th>
                  <th scope="col" class="px-4 py-3 text-left">紫外线</th>
                  <th scope="col" class="px-4 py-3 text-left">日相</th>
                  <th scope="col" class="px-4 py-3 text-left">出行建议</th>
                </tr>
              </thead>
              <tbody>
                {weekDays.map((d, i) => (
                  <tr
                    class={
                      'border-t border-black/8 ' +
                      (i === 0 ? 'bg-cobalt/5' : i % 2 ? 'bg-white' : 'bg-white/70')
                    }
                  >
                    <th scope="row" class="px-4 py-3 text-left font-bold">
                      <div>{d.weekday}</div>
                      <div class="text-xs font-normal text-black/55">{d.date}</div>
                    </th>
                    <td class="px-4 py-3">
                      <div class="flex items-center gap-2">
                        <span class="text-2xl" aria-hidden="true">{d.icon}</span>
                        <span>{d.condition}</span>
                      </div>
                    </td>
                    <td class="px-4 py-3">
                      <strong>{d.tmax}°</strong> <span class="text-black/45">/</span> <span class="text-black/55">{d.tmin}°</span>
                    </td>
                    <td class="px-4 py-3">{d.prob}%</td>
                    <td class="px-4 py-3">UV {d.uv.toFixed(0)}</td>
                    <td class="px-4 py-3 text-xs text-black/55">{d.sunrise} / {d.sunset}</td>
                    <td class="px-4 py-3 font-bold text-black/70">{d.tip}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
