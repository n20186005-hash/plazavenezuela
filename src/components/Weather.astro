---
import { siteInfo } from '../data/site';
import { weatherURL, parseWeather, renderWeather } from '../lib/weather';
const url = weatherURL(siteInfo.latitude, siteInfo.longitude);
let initial = '';
try {
  const response = await fetch(url, { signal: AbortSignal.timeout(8000) });
  if (response.ok) initial = renderWeather(parseWeather(await response.json()));
} catch { /* An unavailable provider must not become invented numeric weather. */ }
---
<section id="clima" class="bg-mist/80 py-24">
  <div class="site-shell">
    <span class="eyebrow text-cobalt">Preparar la salida</span>
    <h2 class="display mt-5 text-[clamp(3rem,6vw,5.8rem)]">El tiempo en Caracas.</h2>
    <p class="mt-6 max-w-3xl leading-8">Consulta la hora del dato y el pronóstico antes de salir. Se intenta actualizar al abrir la página; vuelve a abrirla para solicitar una nueva previsión.</p>
    <p id="weather-status" class="mt-4 text-sm" aria-live="polite">{initial ? 'Datos obtenidos al generar esta página; se intenta una actualización al abrirla.' : 'No se dispone de datos meteorológicos. Comprueba una previsión actual antes de ir.'}</p>
    <div id="weather-root" class="pv-weather" data-weather-url={url}>
      {initial ? <Fragment set:html={initial} /> : <p class="pv-weather-empty">Información temporalmente no disponible; no se muestran valores de ejemplo.</p>}
    </div>
    <p class="mt-6 text-sm leading-7">Datos: <a class="underline" href="https://open-meteo.com/">Open-Meteo</a> · <a class="underline" href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. La previsión puede cambiar. Si falla una actualización, se conservan los datos anteriores con su hora o el aviso de indisponibilidad.</p>
  </div>
</section>
<script>
  import { parseWeather, renderWeather } from '../lib/weather';
  const root = document.getElementById('weather-root'), status = document.getElementById('weather-status');
  const url = root?.getAttribute('data-weather-url');
  if (root && url) fetch(url).then(response => {
    if (!response.ok) throw Error('Weather unavailable');
    return response.json();
  }).then(raw => {
    root.innerHTML = renderWeather(parseWeather(raw));
    if (status) status.textContent = 'Datos actualizados desde el proveedor. Consulta la hora indicada.';
  }).catch(() => {
    if (status) status.textContent = 'No se pudo actualizar. Los datos anteriores, si existen, conservan su hora; consulta una previsión actual antes de salir.';
  });
</script>
