---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada" description="La página solicitada no existe en Guía Plaza Venezuela." noindex>
  <section class="site-shell grid min-h-[62vh] place-items-center py-20 text-center">
    <div class="max-w-2xl">
      <p class="eyebrow text-coral">Error 404</p>
      <h1 class="display mt-5 text-[clamp(3.5rem,9vw,7rem)]">Esta ruta no llega a la plaza.</h1>
      <p class="mx-auto mt-6 max-w-xl leading-8 text-black/60">La página que buscas no existe o cambió de ubicación. Regresa a la guía principal para consultar historia, arte, transporte y datos prácticos.</p>
      <a href="/" class="mt-8 inline-flex rounded-full bg-ink px-6 py-3 text-sm font-bold text-white hover:bg-cobalt">Volver a Plaza Venezuela</a>
    </div>
  </section>
</BaseLayout>
