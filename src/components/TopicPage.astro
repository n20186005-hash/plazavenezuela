---
import { siteInfo } from '../data/site';
import { TOPIC_GROUP_LABELS, getTopic, type Topic } from '../data/topics';
import PhotoCredit from './PhotoCredit.astro';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const c = topic.content!;
const photo = c.photo ? siteInfo.photos[c.photo] : siteInfo.photos.panorama;
const groupLabel = TOPIC_GROUP_LABELS[topic.group];
const siteBase = Astro.site?.origin || 'https://plazavenezuela.org';

const relatedTopics = (c.related || [])
  .map((slug) => getTopic(slug))
  .filter((t): t is Topic => !!t && !!t.content && t.slug !== topic.slug)
  .map((t) => ({ slug: t.slug, title: t.title }));
---

<article class="prose-page">
  <section class="pv-hero relative isolate min-h-[62vh] overflow-hidden bg-ink text-white">
    <img
      src={photo.src}
      alt={photo.alt}
      width={photo.width}
      height={photo.height}
      class="absolute inset-0 h-full w-full object-cover opacity-60"
      referrerpolicy="no-referrer"
    />
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(16,28,26,.9)_0%,rgba(16,28,26,.55)_52%,rgba(16,28,26,.2)_100%)]"></div>
    <div class="site-shell relative flex min-h-[62vh] items-end pb-12 pt-32">
      <div class="max-w-4xl">
        <nav aria-label="Breadcrumb" class="mb-5 text-xs text-white/60">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href={`${siteBase}/`} class="hover:underline">Inicio</a></li>
            <li aria-hidden="true">›</li>
            <li><a href={`${siteBase}/#guias`} class="hover:underline">{groupLabel}</a></li>
            <li aria-hidden="true">›</li>
            <li><span>{c.h1}</span></li>
          </ol>
        </nav>
        <span class="eyebrow text-sun">{c.kicker}</span>
        <h1 class="display mt-5 max-w-4xl text-[clamp(2.6rem,7vw,5.6rem)]">{c.h1}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-white/82 md:text-xl">{c.lead}</p>
        <p class="mt-6 text-xs text-white/55">Última verificación de contenido: {c.updated}</p>
      </div>
    </div>
    <div class="site-shell relative z-10 pb-6"><PhotoCredit photo={photo} /></div>
  </section>

  <section class="site-shell -mt-1 grid border-x border-b border-black/10 bg-paper md:grid-cols-4">
    {c.facts.map((fact) => (
      <div class="border-b border-black/10 p-6 last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0">
        <strong class="display block text-2xl">{fact.value}</strong>
        <span class="mt-2 block text-xs font-bold uppercase tracking-[.1em] text-black/55">{fact.label}</span>
      </div>
    ))}
  </section>

  {c.sections.map((section, i) => (
    <section class:list={["site-shell py-20", i % 2 ? "bg-paper/60" : ""]}>
      <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:gap-16">
        <div>
          <span class="eyebrow text-cobalt">{groupLabel}</span>
          <h2 class="display mt-5 text-[clamp(2.2rem,4.5vw,3.6rem)]">{section.heading}</h2>
        </div>
        <div class="space-y-5 text-[1.05rem] leading-8 text-black/70">
          {section.paragraphs?.map((p) => <p>{p}</p>)}
          {section.bullets && (
            <ul class="space-y-3">
              {section.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
        </div>
      </div>
    </section>
  ))}

  <section id="faq" class="site-shell py-20">
    <div class="grid gap-12 lg:grid-cols-[.62fr_1.38fr]">
      <div>
        <span class="eyebrow text-leaf">Preguntas frecuentes</span>
        <h2 class="display mt-5 text-[clamp(2.4rem,5vw,4rem)]">Antes de ir.</h2>
      </div>
      <div>
        {c.faqs.map((item, i) => (
          <details class="group border-t border-black/15 py-6" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-extrabold">
              <span>{item.q}</span><span class="mt-[-.2rem] text-3xl font-light group-open:rotate-45">+</span>
            </summary>
            <p class="max-w-3xl pt-4 leading-8 text-black/62">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {relatedTopics.length > 0 && (
    <section class="border-t border-black/10 bg-white py-20">
      <div class="site-shell">
        <span class="eyebrow text-coral">Lee también</span>
        <h2 class="display mt-5 text-[clamp(2rem,4vw,3.2rem)]">Guías relacionadas</h2>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {relatedTopics.map((r) => (
            <a href={`${siteBase}/${r.slug}/`} class="group border-t-4 border-ink bg-paper p-6 transition hover:border-cobalt">
              <h3 class="display text-xl">{r.title}</h3>
              <span class="mt-3 inline-block text-sm font-bold text-cobalt group-hover:underline">Ver guía →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="site-shell pb-12 pt-4">
    <p class="text-sm leading-7 text-black/55">
      Guía independiente, sin fines de lucro y de orientación general. La documentación histórica no confirma accesos, servicios ni espectáculos actuales; para decisiones críticas de viaje, confirma condiciones vigentes mediante canales oficiales.
    </p>
  </section>
</article>
